# Copie para .env e ajuste conforme necessário. Todas as variáveis têm padrão.

# Endereço HTTP do servidor local.
LPE_ADDR=:8080

# Caminho do arquivo SQLite.
LPE_DB=data.db

# Provedor de IA. Padrão: ollama (local, custo zero).
# Valores futuros: api (traga sua própria chave Claude/OpenAI).
LPE_AI_PROVIDER=ollama

# Configuração do Ollama (quando LPE_AI_PROVIDER=ollama).
LPE_OLLAMA_URL=http://localhost:11434
LPE_OLLAMA_MODEL=llama3.1
