# Copy to .env and adjust as needed. Every variable has a default.

# Local HTTP server address.
LPE_ADDR=:8080

# Path to the SQLite file.
LPE_DB=data.db

# AI provider. Default: ollama (local, zero cost).
# Future values: api (bring your own Claude/OpenAI key).
LPE_AI_PROVIDER=ollama

# Ollama configuration (when LPE_AI_PROVIDER=ollama).
LPE_OLLAMA_URL=http://localhost:11434
LPE_OLLAMA_MODEL=llama3.1

# LinkedIn app credentials (bring your own — create an app at
# https://www.linkedin.com/developers/ and request the "Share on LinkedIn"
# and "Sign In with LinkedIn using OpenID Connect" products).
# Publishing stays disabled until CLIENT_ID and CLIENT_SECRET are set.
LPE_LINKEDIN_CLIENT_ID=
LPE_LINKEDIN_CLIENT_SECRET=
# Must match exactly an Authorized Redirect URL configured in the LinkedIn app.
LPE_LINKEDIN_REDIRECT_URL=http://localhost:8080/api/linkedin/callback

# Optional: path to the file holding the auto-generated encryption key used to
# protect OAuth tokens at rest. Defaults to the OS config dir.
# LPE_KEY_FILE=
